{
  "name": "slidev-theme-nimbledeck",
  "version": "0.1.0",
  "description": "Nimbledeck base themes: plain, paper and night. Same seven layouts, different design tokens.",
  "keywords": ["slidev-theme", "slidev"],
  "engines": { "slidev": ">=0.50.0" },
  "dependencies": { "slidev-addon-nimbledeck": "*" },
  "slidev": {
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1280,
      "mdc": true,
      "transition": "slide-left",
      "addons": ["slidev-addon-nimbledeck"]
    }
  }
}
